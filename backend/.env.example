# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qa_builder?schema=public"
# Secret used to sign JWT tokens — change in production
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
API_PORT=4000
# Allowed frontend origin (comma separated)
CORS_ORIGIN="http://localhost:5173"
# Directory for uploaded images and attachments
UPLOAD_DIR="uploads"
# Seeded administrator account
ADMIN_EMAIL="admin@qabuilder.local"
ADMIN_PASSWORD="admin12345"
